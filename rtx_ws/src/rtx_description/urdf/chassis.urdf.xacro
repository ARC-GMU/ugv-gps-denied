<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacros">

    <xacro:macro name="chassis" params="">

        <link name="base_link">

            <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <box size="0.6 0.3 0.1"/>
                </geometry>
                <material name="grey"/>
            </visual>

            <collision>
              <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <box size="0.6 0.3 0.1"/>
                </geometry>
            </collision>
        </link>

    </xacro:macro>

</robot>
