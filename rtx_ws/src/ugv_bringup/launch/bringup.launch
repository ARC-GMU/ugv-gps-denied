<launch>
	<node pkg="rosserial_python" type="serial_node.py" name="rtx_controller">
		<param name="port" value="/dev/teensy"/>
		<param name="baud" value="57600"/>
		<param name="scheduler" value="fifo"/>
		<param name="priority" value="98"/>
	</node>
        <node name="cmd_vel_bridge" pkg="ugv_bringup" type="cmd_vel_bridge.py" output="screen" /> 
</launch>
